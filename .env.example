# ==============================================================================
# Google Gemini API Settings
# Get your API key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ==============================================================================
# Qdrant Cloud Vector Database Settings
# ==============================================================================
QDRANT_URL=https://50301dc3-7940-4502-a339-e45356deead7.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace_with_new_api_key
QDRANT_COLLECTION_NAME=rag_documents

# ==============================================================================
# Document Processing & Retrieval Settings
# ==============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
